<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12+ (android:dataExtractionRules): the same single
  AsyncStorage database, for both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="RKStorage" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="RKStorage" />
    </device-transfer>
</data-extraction-rules>
